generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // DIRECT_URL bypasses PgBouncer for migrations — required by Supabase + Prisma
  directUrl = env("DIRECT_URL")
}

model Inquiry {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  name    String
  email   String
  company String?
  website String?

  service     String
  description String  @db.Text
  budgetRange String? @map("budget_range")
  timeline    String?

  status       String    @default("INQUIRY")
  approvedAt   DateTime? @map("approved_at") @db.Timestamptz()
  approvedById String?   @map("approved_by_id") @db.Uuid

  // Rejection closes a lead without creating anything. The reason is an internal note — never shown outside the admin.
  rejectedAt      DateTime? @map("rejected_at") @db.Timestamptz()
  rejectedById    String?   @map("rejected_by_id") @db.Uuid
  rejectionReason String?   @map("rejection_reason")

  // Archiving hides a lead from the open list but leaves everything linked to it untouched.
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz()
  archivedById String?   @map("archived_by_id") @db.Uuid

  source      String?
  utmSource   String? @map("utm_source")
  utmMedium   String? @map("utm_medium")
  utmCampaign String? @map("utm_campaign")
  utmTerm     String? @map("utm_term")
  utmContent  String? @map("utm_content")
  referrer    String?
  metadata    Json?

  user          User?
  companyRecord Company?
  attachments   InquiryAttachment[]
  deliverables  Deliverable[]
  deliverableFolders DeliverableFolder[]
  project       Project?

  @@index([createdAt(sort: Desc)])
  @@index([status])
  @@index([email])
  @@index([archivedAt])
  @@map("inquiries")
}

model InquiryAttachment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // Null while a public upload is waiting to be claimed by a submitted inquiry (status PENDING).
  inquiryId   String? @map("inquiry_id") @db.Uuid
  fileName    String  @map("file_name")
  contentType String  @map("content_type")
  size        Int

  // Bytes live in object storage (storageKey) for new files; older rows keep them in `data` until migrated.
  data       Bytes?
  storageKey String? @unique @map("storage_key")
  sha256     String?
  // PENDING until the bytes have been verified, then READY. Only READY files are ever listed or served.
  status     String  @default("READY")

  inquiry Inquiry? @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId])
  @@index([status, createdAt])
  @@map("inquiry_attachments")
}

model Deliverable {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  inquiryId String? @map("inquiry_id") @db.Uuid
  projectId String? @map("project_id") @db.Uuid

  folderId    String? @map("folder_id") @db.Uuid
  category    String?
  title       String?
  description String?
  watermark   Boolean @default(false)
  fileName    String @map("file_name")
  contentType String @map("content_type")
  size        Int

  data       Bytes?
  storageKey String? @unique @map("storage_key")
  sha256     String?
  status     String  @default("READY")

  // Restrict: a client's deliverables can never disappear because a lead record was removed.
  inquiry Inquiry? @relation(fields: [inquiryId], references: [id], onDelete: Restrict)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder  DeliverableFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  comments DeliverableComment[]

  @@index([inquiryId])
  @@index([projectId])
  @@index([folderId])
  @@index([status, createdAt])
  @@map("deliverables")
}

model DeliverableComment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  deliverableId String @map("deliverable_id") @db.Uuid
  authorName    String @map("author_name")
  body          String @db.Text
  // Public commenters are never verified. PENDING comments wait for an admin when the folder moderates;
  // HIDDEN ones are kept for the record but never shown publicly.
  status        String @default("APPROVED")

  deliverable Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)

  @@index([deliverableId])
  @@index([deliverableId, status])
  @@map("deliverable_comments")
}

model DeliverableFolder {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  inquiryId String? @map("inquiry_id") @db.Uuid
  projectId String? @map("project_id") @db.Uuid

  name        String
  description String?
  isPublic    Boolean @default(false) @map("is_public")
  shareToken  String  @unique @map("share_token")

  commentsEnabled   Boolean @default(true)  @map("comments_enabled")
  commentsModerated Boolean @default(false) @map("comments_moderated")

  // Set whenever the link is replaced (rotate, or sharing switched off/on). Old URLs never work again.
  shareRotatedAt DateTime? @map("share_rotated_at") @db.Timestamptz()

  inquiry      Inquiry?      @relation(fields: [inquiryId], references: [id], onDelete: Restrict)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliverables Deliverable[]

  @@index([inquiryId])
  @@index([projectId])
  @@map("deliverable_folders")
}

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  inquiryId String? @unique @map("inquiry_id") @db.Uuid
  companyId String? @map("company_id") @db.Uuid

  name         String
  email        String  @unique
  passwordHash String? @map("password_hash")
  role         String  @default("CLIENT")
  status       String  @default("INVITED")
  admin        Boolean @default(false)

  // Bumped to revoke every outstanding session cookie for this user (password change, suspension, role change, revoke-all).
  sessionVersion Int @default(0) @map("session_version")

  templogincode          String?   @map("templogincode")
  tempLoginCodeExpiresAt DateTime? @map("temp_login_code_expires_at") @db.Timestamptz()

  invitedAt   DateTime? @map("invited_at") @db.Timestamptz()
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz()

  inquiry  Inquiry?  @relation(fields: [inquiryId], references: [id])
  company  Company?  @relation(fields: [companyId], references: [id])
  projects Project[] @relation("ProjectPrimaryUser")
  passwordResetTokens PasswordResetToken[]

  @@index([companyId])
  @@index([email])
  @@index([status])
  @@map("users")
}

// One row per emailed reset/setup link. Only a keyed hash of the token is stored.
model PasswordResetToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  // RESET: sign-in recovery for an ACTIVE account (1 hour). INVITE: first-time setup for an INVITED account (7 days).
  // The two never substitute for each other.
  purpose    String    @default("RESET")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz()
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// Append-only trail of privileged actions (approvals, status/role changes, session revocation).
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  metadata   Json?

  @@index([createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@index([actorId])
  @@map("audit_logs")
}

model Company {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  inquiryId String? @unique @map("inquiry_id") @db.Uuid

  name    String
  website String?
  status  String  @default("ACTIVE")

  inquiry  Inquiry?  @relation(fields: [inquiryId], references: [id])
  users    User[]
  projects Project[]

  @@index([name])
  @@index([status])
  @@map("companies")
}

model Service {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  name  String
  order Int    @default(0)

  subCategories ServiceSubCategory[]

  @@unique([name])
  @@index([order])
  @@map("services")
}

model ServiceSubCategory {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId String @map("service_id") @db.Uuid

  name  String
  order Int    @default(0)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, name])
  @@index([order])
  @@map("service_sub_categories")
}

model Invoice {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  invoiceNumber String  @map("invoice_number")
  issueDate     String  @map("issue_date")
  dueDate       String  @map("due_date")
  clientName    String  @map("client_name")
  clientEmail   String  @map("client_email")
  clientCompany String? @map("client_company")
  projectName   String  @map("project_name")
  taxRate       Float   @default(0) @map("tax_rate")
  status        String  @default("Unsent")

  lineItems InvoiceLineItem[]

  @@index([createdAt(sort: Desc)])
  @@index([clientEmail])
  @@map("invoices")
}

model InvoiceLineItem {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId String @map("invoice_id") @db.Uuid

  description String
  qty         Float
  rate        Float

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

model Project {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  inquiryId     String? @unique @map("inquiry_id") @db.Uuid
  companyId     String  @map("company_id") @db.Uuid
  primaryUserId String? @map("primary_user_id") @db.Uuid

  name        String
  service     String
  subCategory String? @map("sub_category")
  description String  @db.Text
  budgetRange String? @map("budget_range")
  timeline    String?

  status String @default("ONBOARDING")

  startDate     DateTime? @map("start_date") @db.Date
  targetEndDate DateTime? @map("target_end_date") @db.Date
  completedAt   DateTime? @map("completed_at") @db.Timestamptz()

  deliverables Deliverable[]
  deliverableFolders DeliverableFolder[]
  inquiry     Inquiry? @relation(fields: [inquiryId], references: [id])
  company     Company  @relation(fields: [companyId], references: [id])
  primaryUser User?    @relation("ProjectPrimaryUser", fields: [primaryUserId], references: [id])

  @@index([companyId])
  @@index([primaryUserId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("projects")
}

// Shared counters for the rate limiter (lib/rateLimit.ts). Written with raw SQL; keys are hashed, never emails or IPs.
model RateLimit {
  key          String    @id
  hits         Int
  windowStart  DateTime  @map("window_start") @db.Timestamptz()
  strikes      Int       @default(0)
  blockedUntil DateTime? @map("blocked_until") @db.Timestamptz()
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz()

  @@index([updatedAt])
  @@map("rate_limits")
}

// Durable queue of emails to send. A row is written in the same transaction as the thing that caused it, so an
// SMTP outage can delay an email but never lose it. `payload` holds REFERENCES (ids) only — never tokens, codes
// or passwords; those are generated at send time. Text is rendered from current database data when sent.
model EmailOutbox {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  eventType String @map("event_type")
  recipient String
  // One row per logical email: enqueueing the same event twice (a retried request, a double click) is a no-op.
  dedupeKey String @unique @map("dedupe_key")
  payload   Json?

  // PENDING | SENDING | RETRY | SENT | DEAD (gave up) | SUPPRESSED (deliberately not sent)
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  maxAttempts   Int       @default(8) @map("max_attempts")
  manualRetries Int       @default(0) @map("manual_retries")
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz()
  lockedUntil   DateTime? @map("locked_until") @db.Timestamptz()
  lastError     String?   @map("last_error")
  sentAt        DateTime? @map("sent_at") @db.Timestamptz()

  entityType String? @map("entity_type")
  entityId   String? @map("entity_id")

  @@index([status, nextAttemptAt])
  @@index([createdAt(sort: Desc)])
  @@map("email_outbox")
}

// What happened, for the admin Notifications screen. Real events only; `dedupeKey` makes each event appear once.
model AdminNotification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  type       String
  title      String
  body       String?
  entityType String? @map("entity_type")
  entityId   String? @map("entity_id")
  url        String
  actorId    String? @map("actor_id") @db.Uuid
  dedupeKey  String  @unique @map("dedupe_key")

  reads NotificationRead[]

  @@index([createdAt(sort: Desc)])
  @@map("admin_notifications")
}

// Per-admin read state, so one admin reading an item doesn't hide it from another.
model NotificationRead {
  notificationId String   @map("notification_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  readAt         DateTime @default(now()) @map("read_at") @db.Timestamptz()

  notification AdminNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([userId])
  @@map("notification_reads")
}
