# ── Database (Supabase / PostgreSQL) ─────────────────────────────────────────
# Pooled connection string — used at runtime by Prisma (and PgBouncer on Supabase).
# In Supabase: Settings → Database → Connection string → Transaction mode (port 6543)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?sslmode=require&pgbouncer=true"

# Direct connection string — used by Prisma Migrate (bypasses PgBouncer).
# In Supabase: Settings → Database → Connection string → Session mode (port 5432)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# ── SMTP (email notifications) ────────────────────────────────────────────────
# All four vars must be set to enable email notifications; if any is missing the
# app will skip sending and log a warning instead of erroring.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Address that receives new inquiry notifications
INQUIRY_TO_EMAIL=
# Address shown in the From header (defaults to SMTP_USER if omitted)
INQUIRY_FROM_EMAIL=

# ── App ───────────────────────────────────────────────────────────────────────
APP_URL="https://your-domain.com"

# ── Auth ──────────────────────────────────────────────────────────────────────
# REQUIRED. Two independent random values, each at least 32 characters. There is no default:
# if either is missing, short, a placeholder, or the two are equal, sign-in and password reset
# refuse to work (and the Vercel/CI build fails). Generate each with: openssl rand -hex 32
# Never reuse one for the other, never commit real values.
SESSION_SECRET=
RESET_SECRET=

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Which proxy headers may be believed when working out a visitor's IP address.
#   (unset)   On Vercel this is automatic. Anywhere else, forwarded headers are ignored (every visitor shares one bucket).
#   vercel    Trust Vercel's client-IP headers.
#   hops:N    N trusted reverse proxies append to X-Forwarded-For (e.g. hops:1 behind a single load balancer).
# Never set this to something your hosting does not actually enforce: untrusted headers let anyone dodge the limits.
TRUSTED_PROXY=

# ── File storage (private Supabase Storage bucket) ────────────────────────────
# Without these the app still works, but file bytes go through the server and into the database, which cannot
# carry large files on Vercel (4.5 MB request / response limit). See README → "Files & storage".
# SUPABASE_URL: Project Settings → API → Project URL.  SUPABASE_SERVICE_ROLE_KEY: the service_role key.
# The service-role key bypasses all access rules: server-only, never prefix it NEXT_PUBLIC_, never commit it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Name of the PRIVATE bucket (default: dreamable-files).
STORAGE_BUCKET=dreamable-files

# Shared secret for the daily cleanup job (vercel.json). Vercel sends it automatically as a Bearer token.
# At least 16 random characters: openssl rand -hex 24
CRON_SECRET=

# ── Email delivery safety ─────────────────────────────────────────────────────
# Real email is only ever sent from a production deployment. Everywhere else (local dev, Vercel previews,
# tests) nothing reaches a real customer:
#   (unset)  development / preview: email is suppressed (the admin shows it as "not sent: this environment …")
#   EMAIL_TRANSPORT=console   development only: print each message (incl. reset links) to the server console
#   EMAIL_DEV_ALLOWLIST=you@example.com,@yourteam.com   development / preview: really send, but ONLY to these
#                              addresses (or whole @domains)
EMAIL_TRANSPORT=
EMAIL_DEV_ALLOWLIST=

